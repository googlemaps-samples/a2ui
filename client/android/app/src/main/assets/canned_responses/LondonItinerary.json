      {
        "contextId": "CC896B42-2507-41A3-A5DB-35394856B8A5",
        "kind": "message",
        "messageId": "0bb55232-d122-4f0f-97cf-f3a90c7d3f88",
        "parts": [
          {
            "data": {
              "version": "v0.9",
              "updateComponents": {
                "surfaceId": "london-itinerary-surface",
                "components": [
                  {
                    "id": "root",
                    "component": "Column",
